# Copy to .env and fill in values: cp .env.example .env
# Used by docker compose (see docker-compose.yml).

# Server run mode: dev (hot reload via spring-boot:run) or prod (packaged jar)
MODE=<dev|prod>

# PostgreSQL database name
POSTGRES_DB=<database_name>

# PostgreSQL username
POSTGRES_USER=<username>

# PostgreSQL password
POSTGRES_PASSWORD=<password>

# Host port mapped to Postgres (container port 5432)
POSTGRES_PORT=<host_port>

# Host port mapped to the Spring Boot server (container port 8080)
SERVER_PORT=<host_port>
