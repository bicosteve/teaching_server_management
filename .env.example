# Copy to .env and fill in values: cp .env.example .env
# Used by docker compose (see docker-compose.yml).

# Server run mode: dev (hot reload via spring-boot:run) or prod (packaged jar)
MODE=<dev|prod>

# PostgreSQL hostname (localhost from the host; Compose overrides to db in the server container)
POSTGRES_HOST=<hostname>

# PostgreSQL database name
POSTGRES_DB=<database_name>

# PostgreSQL username
POSTGRES_USER=<username>

# PostgreSQL password
POSTGRES_PASSWORD=<password>

# PostgreSQL port (host mapping / client port)
POSTGRES_PORT=<port>

# Host port mapped to the Spring Boot server (container port 8080)
SERVER_PORT=<host_port>

# JWT HS256 secret (at least 32 characters)
JWT_SECRET=<random_secret_at_least_32_chars>

# JWT access-token lifetime in milliseconds (optional; default 86400000 = 24h)
JWT_EXPIRATION_MS=<milliseconds>
